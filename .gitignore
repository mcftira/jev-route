# --- Secrets and local config ---------------------------------------------
# The repo root .env holds TYPESAFE_API_KEY / ALIBABA_API_KEY. Nothing in the
# codebase needs it committed: MockBackend is deterministic and offline.
.env
.env.*
# ...but the documented template is safe and belongs in git.
!.env.example
*.pem
*.key

# --- Decision logs: this IS the training data -----------------------------
# Every routing decision is appended here with its full soft probability
# distribution. It is user traffic, it may contain PII, and it is worth money
# to whoever owns it. Never commit it.
decision-log/
# Scratch space for exercising the graduation pipeline locally.
tmp-graduation/
# Generic sidecar: nothing in-tree ships loose .jsonl except the labelled eval
# dataset, which is negated right below.
*.jsonl
!evals/data/*.jsonl
# Rotated and compressed log sidecars (decisions.jsonl.1, decisions.jsonl.gz).
*.jsonl.1
*.jsonl.gz
# `*.jsonl` above already covers rotated names such as decisions.2026-09-19.jsonl,
# so no extra pattern is needed for them.

# --- Distillation artifacts and model weights -----------------------------
# Generated by the graduation pipeline; reproducible from the decision log.
# Never exclude `artifacts/` as a bare directory: git cannot re-include a file
# whose parent directory is excluded. Exclude the contents, re-include the
# directories so git can still walk them, then keep the placeholders.
artifacts/**
!artifacts/**/
!artifacts/.gitkeep
!artifacts/**/.gitkeep
*.safetensors
*.gguf
*.onnx
*.pt
*.pth
*.bin
*.ckpt
*.npz
*.pkl
*.joblib

# --- Python build / packaging ---------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
env/
dist/
build/
*.egg-info/
*.egg
.eggs/
wheels/
pip-wheel-metadata/

# --- Tooling caches --------------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
.tox/
.nox/

# --- Generated eval / report outputs --------------------------------------
# Reports are produced by a run, not authored; evals/data/ is the only eval
# path that is checked in.
evals/reports/
eval-results/
*.local.yaml
policies/*.local.yaml

# --- OS / editor cruft -----------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

# Generated by deploy/k8s/build_configmap.py from src/ -- committing these would
# just create a second copy of the package that silently goes stale.
deploy/k8s/15-generated.yaml
deploy/k8s/16-code-volume-items.yaml

# `graduate --write` and its tests drop a cutover policy here (plus .bak copies
# of whatever was there before). It is generated output, not authored policy.
policies/default-graduated.yaml
policies/default-graduated.bak-*.yaml
